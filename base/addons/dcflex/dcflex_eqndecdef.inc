EQUATIONS
QDCF_BAL(Y,RRR,S,T)   'DC backlog balance (Senga Eq. 1)'
QDCF_DEFER(Y,RRR,S,T) 'Deferred DC load served within h (Senga Eq. 2)'
QDCF_ADV(Y,RRR,S,T)   'Advanced DC load offset within h (Senga Eq. 3)'
QDCF_CAP(Y,RRR,S,T)   'DC load after shifting within capacity (Senga Eq. 5)'
;

QDCF_BAL(IY411,IR,IS3,T)$IDCF(IY411,IR)..
   VDCF_Y(IY411,IR,IS3,T) =E= VDCF_Y(IY411,IR,IS3,T--1) - VDCF_S(IY411,IR,IS3,T) + VDCF_D(IY411,IR,IS3,T);

QDCF_DEFER(IY411,IR,IS3,T)$IDCF(IY411,IR)..
   SUM(ITALIAS$IDCF_WINFWD(T,ITALIAS), VDCF_S(IY411,IR,IS3,ITALIAS)) =G= VDCF_Y(IY411,IR,IS3,T);

QDCF_ADV(IY411,IR,IS3,T)$IDCF(IY411,IR)..
   SUM(ITALIAS$IDCF_WINFWD(T,ITALIAS), VDCF_D(IY411,IR,IS3,ITALIAS)) =G= -VDCF_Y(IY411,IR,IS3,T);

QDCF_CAP(IY411,IR,IS3,T)$IDCF(IY411,IR)..
   VDCF_S(IY411,IR,IS3,T) - VDCF_D(IY411,IR,IS3,T) =L= IDCF_C(IY411,IR) - IDCF_L(IY411,IR,IS3,T);
